{
  "parameters": {
    "volume_ratio_threshold": 1.5,
    "adx_threshold": 25
  },
  "conditions": [
    { "left": "ltp", "op": "crossed_above", "right": { "field": "vwap" }, "inclusive": true },
    { "left": "ema9", "op": ">", "right": { "field": "ema21" } },
    { "left": "volume_ratio", "op": ">=", "right": { "param": "volume_ratio_threshold" } },
    { "left": "adx", "op": ">=", "right": { "param": "adx_threshold" } }
  ]
}
